<Application x:Class="Aestoys.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- White knob on the accent track (the theme's default turns black on light accents). -->
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#F2F2F2" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
