<Window x:Class="Aestoys.Features.AltTab.SwitcherWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aestoys switcher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" Focusable="False">
    <Window.Resources>
        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="156" Height="132" Margin="4" CornerRadius="8"
                                Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="10" BorderThickness="1" Padding="10" Margin="0"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}">
        <Grid>
            <TextBlock x:Name="EmptyText" Text="No windows on this monitor" Visibility="Collapsed"
                       Margin="24,16" FontSize="14" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Focusable="False"
                         ItemContainerStyle="{StaticResource TileStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="List_OnMouseUp">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="Wrap" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,14,10,8">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" Margin="0,10,0,0" TextAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                           FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
