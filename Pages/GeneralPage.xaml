<Page x:Class="Aestoys.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="General">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="900">
            <TextBlock Text="General" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Rocket24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Run on startup" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Start aestoys in the system tray when you sign in" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupToggle" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ShieldKeyhole24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Run as administrator" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Lets the switcher work while an admin app has focus and preview admin windows. Windows asks for permission when you turn it on." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AdminToggle" Checked="OnAdminChanged" Unchecked="OnAdminChanged" />
            </ui:CardControl>

            <ui:InfoBar x:Name="StatusBar" Margin="0,4,0,4" IsOpen="False" IsClosable="True" />

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Quit aestoys" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Closing this window keeps aestoys running in the tray. This stops it completely." FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Quit" Click="OnQuit" />
            </ui:CardControl>

            <TextBlock x:Name="VersionText" Margin="0,20,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
