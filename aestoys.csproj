<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>aestoys</AssemblyName>
    <RootNamespace>Aestoys</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Precompiled code: no JIT pause on the first Alt+Tab after start-up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native DLL, loaded at run time from next to aestoys.exe (not bundled into the single file). -->
    <None Include="ThirdParty\VirtualDesktopAccessor\VirtualDesktopAccessor.dll" Link="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The File Explorer add-ons are their own project. -->
    <Compile Remove="ShellExt\**" />
    <None Remove="ShellExt\**" />
    <Page Remove="ShellExt\**" />
  </ItemGroup>
  <!-- File Explorer add-ons: built separately and published to shellext\<build time>\ so a new build
       never has to overwrite DLLs that Windows' preview/thumbnail hosts still have loaded. -->
  <Target Name="PublishShellExt" AfterTargets="Publish">
    <MSBuild Projects="ShellExt\aestoys.ShellExt.csproj" Targets="Restore;Build" Properties="Configuration=Release;PublishSingleFile=false;RuntimeIdentifier=win-x64" />
    <PropertyGroup>
      <ShellExtStamp>$([System.DateTime]::Now.ToString(yyyyMMddHHmmss))</ShellExtStamp>
    </PropertyGroup>
    <ItemGroup>
      <ShellExtFiles Include="ShellExt\bin\Release\net10.0-windows10.0.19041.0\win-x64\**\*" Exclude="ShellExt\bin\Release\net10.0-windows10.0.19041.0\win-x64\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ShellExtFiles)" DestinationFiles="@(ShellExtFiles->'$(PublishDir)shellext\$(ShellExtStamp)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>

